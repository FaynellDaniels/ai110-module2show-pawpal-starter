classDiagram
    class Owner {
        +String name
        +Time available_time
        +List~String~ preferences
        +add_preference()
        +update_availability()
        +get_preferences()
    }

    class Pet {
        +String name
        +String species
        +Integer age
        +String breed
        +String care_needs
        +add_task()
        +remove_task()
        +get_tasks()
        +update_care_needs()
    }

    class Task {
        +String name
        +String task_type
        +Integer duration
        +Integer priority
        +Time preferred_time
        +Boolean completed
        +mark_complete()
        +update_task()
        +get_duration()
        +get_priority()
    }

    class Constraint {
        +Time available_time
        +Integer max_task_duration
        +List~Time~ preferred_times
        +List~String~ owner_preferences
        +check_task()
        +is_satisfied()
        +update_constraint()
    }

    class Schedule {
        +Date date
        +List~Task~ tasks
        +Integer total_duration
        +Integer remaining_time
        +add_task()
        +remove_task()
        +calculate_duration()
        +get_remaining_time()
    }

    class Scheduler {
        +List~Task~ tasks
        +List~String~ constraints
        +Owner owner
        +Pet pet
        +generate_plan()
        +prioritize_tasks()
        +check_constraints()
        +explain_plan()
    }

    Owner "1" --> "1" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Schedule "1" o-- "0..*" Task : includes
    Scheduler "1" o-- "0..*" Constraint : applies
    Scheduler --> Owner : uses
    Scheduler --> Pet : plans care for
    Scheduler --> Schedule : generates
